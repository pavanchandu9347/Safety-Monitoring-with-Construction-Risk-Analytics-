# Environment configuration for the Agentic Construction Risk Intelligence Platform

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8001

# Database (SQLite by default for Milestone 1)
DATABASE_URL=sqlite:///./construction_risk.db

# Frontend
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=5179
VITE_API_BASE=/api

# Computer Vision
CV_MODEL_NAME=yolov8n.pt
CV_CONF_THRESHOLD=0.35
CV_IOU_THRESHOLD=0.45

# Live video-analysis pipeline (risk derived from real YOLO detections)
# PPEModel weights (Construction-PPE). See ai/computer_vision/ppe_detector.py.
YOLO_MODEL_PATH=ai/models/ppe.pt
# Local video file, webcam index (e.g. 0), or RTSP/HTTP stream URL.
VIDEO_SOURCE=/Users/pavanchandu/Downloads/Site_construction.mp4
YOLO_CONFIDENCE=0.35
# Seconds between inference batches (~2 per second default).
DETECTION_INTERVAL=0.5

# Demo site
DEMO_SITE_ID=site_riverside_main
