# Environment template for BuildSure. Copy to `.env` and fill in real values.

# ── Docker Compose (docker compose up --build -d) ─────────────────────────────
# Secrets are never committed; compose fails fast when these are unset.
#
#   cp .env.example .env
#   openssl rand -hex 32   # use the output for JWT_SECRET_KEY
#   docker compose up --build -d

APP_ENV=production
LOG_LEVEL=INFO

# Backend API port (single, consistent port across the whole stack).
PORT=8000

# PostgreSQL credentials (compose provisions the server automatically).
POSTGRES_DB=buildsure
POSTGRES_USER=buildsure
# POSTGRES_PASSWORD=<openssl rand -hex 32>

# Persistent JWT signing secret (>= 32 bytes). Set once and never rotate casually:
# it signs every manager session token. Production refuses to start without it.
# JWT_SECRET_KEY=<openssl rand -hex 32>

# The HTTP port the nginx frontend container is published on.
FRONTEND_PORT=8080

# DEMO_MODE=true seeds/reconciles a built-in manager for local/demo use.
# DEMO_MODE=false disables the built-in account and the demo quick-access login.
DEMO_MODE=true
DEFAULT_MANAGER_EMAIL=BuildSure@gmail.com
DEFAULT_MANAGER_PASSWORD=123456

# Comma-separated browser origins allowed to call the API cross-origin. Leave
# empty when browser and API share an origin (nginx same-origin proxy is the
# default topology).
# CORS_ALLOW_ORIGINS=https://app.example.com

# Maximum accepted video upload in MB (HTTP 413 above this).
MAX_UPLOAD_SIZE_MB=500

# Non-compose deployments (local dev): point the backend at PostgreSQL instead
# of the SQLite fallback.
# DATABASE_URL=postgresql+psycopg2://buildsure:CHANGE-ME@localhost:5432/buildsure
# VITE_API_URL=/api          # same-origin default (/api prefix included)
# An absolute URL must include the /api suffix too, e.g. https://api.example.com/api