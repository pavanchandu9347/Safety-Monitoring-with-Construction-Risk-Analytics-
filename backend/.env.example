# ── Unified video-analysis pipeline configuration ─────────────────────────────
# The single primary input: path (or camera) the platform analyzes.
# Auto-discovery picks the construction-site video in the project folder when
# this is empty. Uploaded videos are stored under VIDEO_STORAGE_PATH.
VIDEO_SOURCE=
VIDEO_STORAGE_PATH=data/videos

# Primary video stem used during auto-discovery (matches Contruction_vid.mp4).
PRIMARY_VIDEO_STEM=contruction_vid

# Sampling across the whole clip (the fixed budget is spread evenly over the
# video's duration so late footage is represented).
FRAME_SAMPLE_RATE=15
MAX_FRAMES=30

# Inference settings for object + PPE detection.
CONFIDENCE_THRESHOLD=0.45
PROCESS_WIDTH=1280

# ── Web server ────────────────────────────────────────────────────────────────
# HOST=0.0.0.0
# PORT=8001

# Allowed CORS origins (comma-separated). When empty, localhost dev origins are
# used and credentials are disabled (wildcard + credentials is invalid per CORS).
# CORS_ALLOW_ORIGINS=http://localhost:5179

# ── Manager authentication (Milestone 4) ──────────────────────────────────────
# REQUIRED in any non-local deployment. Must be a long random secret (>=32 bytes).
# If unset, a per-process random secret is used: every restart invalidates tokens.
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Seeded demo manager account (placeholder credentials — set real values in .env,
# never commit real secrets). If the password is left empty a cryptographically
# random one is generated and logged once at startup.
DEFAULT_MANAGER_EMAIL=manager@buildsure.io
DEFAULT_MANAGER_PASSWORD=
DEFAULT_MANAGER_NAME=Riverside Site Manager

# ── Intelligent risk alerts (Milestone 4) ─────────────────────────────────────
# Score thresholds for HIGH notifications. Scores use the project's 0-100 bands
# (50=HIGH, 75=CRITICAL). Raise to 75 to make alerts CRITICAL-only.
RISK_ALERT_THRESHOLD=50
SAFETY_ALERT_THRESHOLD=50

# Minimum severity routed to EXTERNAL channels (email). MEDIUM and below are
# in-app only.
EMAIL_ALERT_MIN_LEVEL=HIGH

# Cooldown before the same continuous condition is alerted again. A HIGH→CRITICAL
# escalation bypasses the cooldown so urgent changes are always delivered.
NOTIFICATION_COOLDOWN_SECONDS=300

# ── External notification channel: SMTP email (optional) ──────────────────────
# Notifications still work in-app when any of these are unset; the email path is
# simply skipped and logged.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
NOTIFICATION_EMAIL_FROM=