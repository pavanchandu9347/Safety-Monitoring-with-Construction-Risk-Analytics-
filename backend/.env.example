# ── Unified video-analysis pipeline configuration ─────────────────────────────
# The single primary input: path (or camera) the platform analyzes.
# Auto-discovery picks the construction-site video in the project folder when
# this is empty. Uploaded videos are stored under VIDEO_STORAGE_PATH.
VIDEO_SOURCE=
VIDEO_STORAGE_PATH=data/videos

# Primary video stem used during auto-discovery (matches Contruction_vid.mp4).
PRIMARY_VIDEO_STEM=contruction_vid

# Sampling across the whole clip (the fixed budget is spread evenly over the
# video's duration so late footage is represented).
FRAME_SAMPLE_RATE=15
MAX_FRAMES=30

# Inference settings for object + PPE detection.
CONFIDENCE_THRESHOLD=0.45
PROCESS_WIDTH=1280

# ── Web server ────────────────────────────────────────────────────────────────
# The whole stack converges on one backend port, 8000 (Vite dev proxy and the
# nginx container both forward /api to it).
HOST=0.0.0.0
PORT=8000

# Allowed CORS origins (comma-separated). When empty, localhost dev origins are
# used and credentials are disabled (wildcard + credentials is invalid per CORS).
# Set this explicitly when the browser is served from a different origin.
# CORS_ALLOW_ORIGINS=http://localhost:5179,http://localhost:8080

# Public URL of the running deployment (used for links in notifications).
DEPLOYMENT_URL=http://localhost:5179

# ── Manager authentication (Milestone 4) ──────────────────────────────────────
# REQUIRED when APP_ENV=production (startup fails fast if it is missing). Must
# be a long random secret (>= 32 bytes). Persist it across restarts so issued
# tokens stay valid:
#   openssl rand -hex 32
# In development only, an unset value falls back to a per-process random secret
# (every restart invalidates tokens).
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── Deployment profile ────────────────────────────────────────────────────────
# APP_ENV=production fail-fast requires JWT_SECRET_KEY. Runtime profile + log level.
APP_ENV=development
LOG_LEVEL=INFO

# Database override (SQLAlchemy URL). Defaults to the local SQLite
# backend/construction_risk.db when unset. PostgreSQL for production:
# DATABASE_URL=postgresql+psycopg2://buildsure:CHANGE-ME@localhost:5432/buildsure

# Demo mode. DEMO_MODE=false disables seeding/reconciling the built-in manager
# account (real production should provision accounts itself) and the login page
# quick-access card is compiled out (VITE_DEMO_MODE=false).
DEMO_MODE=true

# Seeded demo manager account (only in DEMO_MODE=true). On startup the stored
# account is reconciled so the configured email/password always authenticate.
# Override these in backend/.env for any real deployment — never commit secrets.
DEFAULT_MANAGER_EMAIL=BuildSure@gmail.com
DEFAULT_MANAGER_PASSWORD=123456
DEFAULT_MANAGER_NAME=Riverside Site Manager

# ── Uploads (video input) ─────────────────────────────────────────────────────
# Maximum accepted video upload in MB. Oversize uploads are rejected with HTTP
# 413; files are streamed to disk (never fully buffered in RAM).
MAX_UPLOAD_SIZE_MB=500

# ── Login rate limiting ───────────────────────────────────────────────────────
# After LOGIN_MAX_ATTEMPTS failed logins within LOGIN_WINDOW_SECONDS, the client
# IP is temporarily locked out (HTTP 429). In-process; effective on the single
# gunicorn worker configuration shipped in Docker.
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900

# ── Intelligent risk alerts (Milestone 4) ─────────────────────────────────────
# Score thresholds for HIGH notifications. Scores use the project's 0-100 bands
# (50=HIGH, 75=CRITICAL). Raise to 75 to make alerts CRITICAL-only.
RISK_ALERT_THRESHOLD=50
SAFETY_ALERT_THRESHOLD=50

# Minimum severity routed to EXTERNAL channels (email). MEDIUM and below are
# in-app only.
EMAIL_ALERT_MIN_LEVEL=HIGH

# Cooldown before the same continuous condition is alerted again. A HIGH→CRITICAL
# escalation bypasses the cooldown so urgent changes are always delivered.
NOTIFICATION_COOLDOWN_SECONDS=300

# ── External notification channel: SMTP email (optional) ──────────────────────
# Notifications still work in-app when any of these are unset; the email path is
# simply skipped and logged.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
NOTIFICATION_EMAIL_FROM=